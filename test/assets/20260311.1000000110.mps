@task[  work  ,   status: open  ]{
  Task with extra whitespace in args
}

@note[   ]{
  Note with whitespace-only args (treated as no args)
}

@log[ start: 09:00 , end: 10:00 ]{
  Log with spaces padding the time args
}

@task[ status: done , work ]{
  Task with spaces and reversed attr/tag order
}
