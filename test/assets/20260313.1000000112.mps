@mps{
  @mps{
    @mps{
      @mps{
        @task{ Five levels deep }
      }
      @task{ Four levels deep }
    }
    @task{ Three levels deep }
    @note{ Note at three levels }
  }
  @task{ Two levels deep }
}
@task[work, status: done]{ Root task one }
@task[work, status: open]{ Root task two }
@note{ Root note }
